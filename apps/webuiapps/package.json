{
  "name": "@openroom/webuiapps",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "debug": "vite --debug",
    "build:test": "vite build --mode test",
    "build": "vite build --mode production",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "daemon:build": "vite build --config vite.daemon.config.ts",
    "daemon": "node dist-daemon/aoiDaemonServer.js",
    "daemon:supervise": "node dist-daemon/aoiDaemonServer.js --supervise",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "field-ci:gate": "vitest run src/lib/__tests__/aoiFieldCiGate.test.ts src/lib/__tests__/aoiFieldGroundedJarvisAcceptancePack.test.ts src/lib/__tests__/aoiRealFieldOperationsAcceptancePack.test.ts",
    "field-ci:build": "vite build --config vite.field-ci-gate.config.ts",
    "field-ci": "node dist-field-ci-gate/aoiFieldCiGate.js",
    "real-field:build": "vite build --config vite.real-field-acceptance.config.ts",
    "real-field": "node dist-real-field-acceptance/aoiRealFieldAcceptance.js",
    "nonvoice-claim:build": "vite build --config vite.non-voice-claim.config.ts",
    "nonvoice-claim": "npm run nonvoice-claim:build && node dist-non-voice-claim/aoiNonVoiceClaim.js",
    "nonvoice-validation:build": "vite build --config vite.non-voice-validation.config.ts",
    "nonvoice-validation": "npm run nonvoice-validation:build && node dist-non-voice-validation/aoiNonVoiceValidation.js",
    "controlled-real-file:build": "vite build --config vite.controlled-real-file.config.ts",
    "controlled-real-file": "node dist-controlled-real-file/aoiControlledRealFileEvidence.js",
    "controlled-real-cognition:build": "vite build --config vite.controlled-real-cognition.config.ts",
    "controlled-real-cognition": "node dist-controlled-real-cognition/aoiControlledRealCognitionEvidence.js",
    "user-authorized-plan:build": "vite build --config vite.user-authorized-plan.config.ts",
    "user-authorized-plan": "node dist-user-authorized-plan/aoiUserAuthorizedPlan.js",
    "measured-memory-recall:build": "vite build --config vite.measured-memory-recall.config.ts",
    "measured-memory-recall": "node dist-measured-memory-recall/aoiMeasuredMemoryRecall.js",
    "claim-sweep:build": "vite build --config vite.claim-sweep.config.ts",
    "claim-sweep": "npm run claim-sweep:build && node dist-claim-sweep/aoiClaimSweep.js"
  },
  "dependencies": {
    "framer-motion": "^12.34.0",
    "jszip": "^3.10.1",
    "mermaid": "^11.16.0",
    "playwright-core": "^1.58.2",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.72",
    "@testing-library/dom": "^9",
    "@testing-library/react": "^14",
    "@testing-library/user-event": "^14",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vitest/coverage-v8": "^1.6.1",
    "happy-dom": "^14.0.0",
    "jsdom": "^25.0.0",
    "vitest": "^1.6.1"
  }
}
